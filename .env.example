NODE_ENV=production

# ===== توكنات بوتات Telegram (من @BotFather) - بوت التاجر وبوت السوبر أدمن فقط =====
# بوت التاجر: يديره صاحب كل متجر (منتجات/طلبات)
TELEGRAM_MERCHANT_BOT_TOKEN=
# بوت السوبر أدمن: خاص بك أنت فقط - إضافة/تعديل/إيقاف/حذف المتاجر والباقات
TELEGRAM_SUPERADMIN_BOT_TOKEN=

# ===== Facebook Messenger (بوت الزبائن) =====
# هذه صفحة "مشتركة" احتياطية تستعملها المتاجر اللي ما ربطوش صفحتهم الخاصة بعد.
# كل تاجر يقدر الآن يربط صفحته الخاصة من داخل بوت التاجر (⚙️ الإعدادات > ربط صفحة فيسبوك الخاصة بي).
# من إعدادات تطبيق فيسبوك الخاص بك (Meta for Developers > Messenger > Settings)
FB_PAGE_ACCESS_TOKEN=
# اختره أنت بنفسك (أي نص سري) وضعه أيضًا في إعدادات webhook داخل تطبيق فيسبوك
FB_VERIFY_TOKEN=
# مطلوب لتفعيل "ربط الصفحة بضغطة واحدة" (OAuth) - من App Settings > Basic > App Secret
FB_APP_SECRET=
# مطلوب لتفعيل "ربط الصفحة بضغطة واحدة" (OAuth) - من App Settings > Basic > App ID
FB_APP_ID=
# اسم مستخدم صفحتك على فيسبوك (بدون @) - لعرض رابط m.me جاهز لكل متجر داخل بوت التاجر
FB_PAGE_USERNAME=
# المنفذ الذي يشتغل عليه سيرفر webhook - Railway يوفره تلقائيًا عبر PORT، لا تغيّره عادة
PORT=3000

# الرابط العام لخدمة بوت الزبائن على Railway (فعّل "Generate Domain" من Networking).
# ضروري لتفعيل "ربط الصفحة بضغطة واحدة" (OAuth redirect + webhook). بلا / فـ الآخر.
# مثال: https://your-app.up.railway.app
APP_BASE_URL=

# ===== Firebase (Firebase Console > Project Settings > Service Accounts > Generate New Private Key) =====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# اختياري: فقط إذا أنشأت قاعدة Firestore باسم غير الافتراضي "(default)".
# شوف المعرف بالضبط من Firebase Console > Firestore Database > القائمة فوق (بجانب "default").
# إذا سيبتها فارغة، الكود يستعمل القاعدة الافتراضية "(default)" مباشرة.
FIREBASE_DATABASE_ID=

# ===== السوبر أدمن =====
# رقم Telegram ID الخاص بك (مطلوب). فقط هذا الرقم يقدر يستعمل بوت السوبر أدمن.
# اعرف رقمك عبر إرسال /start لبوت @userinfobot
SUPER_ADMIN_TELEGRAM_ID=

# ===== اختياري: Groq API (تحويل صوت لنص + تحليل صور) =====
# بدون هذا المفتاح، البوت يشتغل عادي لكن يرسل رسالة بديلة بدل تفعيل هذه الميزات
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ===== اللوقات =====
LOG_LEVEL=info
LOG_DIR=logs

# ===== حماية من الطلبات الكثيرة (Rate Limiting) =====
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX=15

# اختياري: إذا توفر عندك Redis لاحقًا، حطه هنا وسيستعمله نظام الطوابير تلقائيًا
REDIS_URL=

# ===== الدفع الإلكتروني عبر Chargily Pay (إدهابية Algérie Poste + بطاقة CIB) =====
# سجّل حساب مجانًا على https://pay.chargily.com ثم خذ المفتاح من API Keys
# بدون هذا المفتاح، الموقع يعمل عاديًا لكن زر الدفع يعرض رسالة "الدفع غير مفعّل بعد"
CHARGILY_SECRET_KEY=
CHARGILY_PUBLIC_KEY=
# true = وضع الاختبار (بطاقات وهمية بدون خصم فعلي). بدّلها إلى false عند الانطلاق الحقيقي
CHARGILY_TEST_MODE=true

# نسبة خصم أول عملية شراء مدفوعة لكل متجر جديد (بالمئة)
FIRST_PURCHASE_DISCOUNT_PERCENT=30

# ===== روابط التواصل الاجتماعي (تظهر في القائمة الجانبية "تابعنا" على الموقع) =====
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_WHATSAPP_URL=

# ===== تسجيل الدخول/التسجيل عبر Google (Google Identity Services) من الموقع =====
# أنشئ OAuth Client ID من https://console.cloud.google.com/apis/credentials (Web application)
# وأضف رابط موقعك (APP_BASE_URL) في "Authorized JavaScript origins".
# بدون هذا المفتاح، صفحات /login.html و /signup.html تعرض رسالة أن الميزة غير مفعّلة بعد.
GOOGLE_CLIENT_ID=

# ===== إرسال الإيميلات عبر Resend (https://resend.com/api-keys) =====
# اختياري - بدونه، النظام يعمل عاديًا بدون إرسال إيميلات ترحيبية/تأكيد.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ===== مفتاح توقيع جلسات الموقع - غيّره لقيمة عشوائية طويلة وسرية في الإنتاج =====
WEB_SESSION_SECRET=
